modules = ["nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
MP_PRICE_ARS = "5500"
MP_PREAPPROVAL_PLAN_ID_COMPANY = "d38999bc63124981b04c6a1a2907284b"
MP_PREAPPROVAL_PLAN_ID_TEAM = "1cbeba0be7bd49cc92d3ee343c18a04f"

[userenv.production]
APP_PUBLIC_URL = "https://sipwell.app"
ALLOWED_ORIGIN = "https://sipwell.app"
CANONICAL_URL = "https://sipwell.app"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18319
externalPort = 80
