{ "$schema": "https://openapi.vercel.sh/vercel.json", 
  "buildCommand": "pnpm --filter @workspace/break-buddy build && pnpm --filter @workspace/api-server build", 
  "outputDirectory": "artifacts/break-buddy/dist/public", "installCommand": "pnpm install --frozen-lockfile", 
  "rewrites": [ { "source": "/api/:path*", "destination": "/api/[...path]" } ] 
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/:path*", "destination": "/api/[...path]" }
  ]
}
